# ===== Build outputs =====
build/
dist/
*.apk

# ===== Compose dependencies (regenerated by tools/resolve.py) =====
libs/

# ===== Downloaded build tools (fetched by build-apk.sh / build.bat on first run) =====
tools/*.jar

# ===== IDE / OS noise =====
.idea/
*.iml
.DS_Store

# ===== Signing =====
# The debug keystore stays in the repository so debug builds keep a stable
# signature across machines. Release keystores are never committed.
*.keystore
!debug.keystore

# ===== Secrets / logs =====
.env
*.log
